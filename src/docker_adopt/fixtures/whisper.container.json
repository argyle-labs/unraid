      "NV_CUDA_LIB_VERSION=12.6.3-1",
      "NVIDIA_VISIBLE_DEVICES=all",
      "NVIDIA_DRIVER_CAPABILITIES=compute,utility",
      "LANG=C.UTF-8",
      "PYTHONUNBUFFERED=1"
    ],
    "Cmd": ["gunicorn", "--bind", "0.0.0.0:9000", "--workers", "1", "--timeout", "0", "app.webservice:app", "-k", "uvicorn.workers.UvicornWorker"],
    "Entrypoint": null,
    "Image": "onerahmet/openai-whisper-asr-webservice:latest-gpu",
    "Labels": {
      "maintainer": "NVIDIA CORPORATION <cudatools@nvidia.com>",
      "org.opencontainers.image.ref.name": "ubuntu"
    }
  },
  "HostConfig": {
    "NetworkMode": "bridge",
    "Privileged": false,
    "PortBindings": { "9000/tcp": [{ "HostIp": "", "HostPort": "10300" }] },
    "RestartPolicy": { "Name": "unless-stopped", "MaximumRetryCount": 0 },
    "LogConfig": { "Type": "json-file", "Config": {} },
    "Tmpfs": null,
    "DeviceRequests": [
      { "Driver": "", "Count": -1, "DeviceIDs": null, "Capabilities": [["gpu"]], "Options": {} }
    ],
    "ShmSize": 67108864,
    "IpcMode": "private",
    "Runtime": "runc"
  },
  "Mounts": [
