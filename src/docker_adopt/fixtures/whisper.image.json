{
  "Id": "sha256:2222222222222222222222222222222222222222222222222222222222222222",
  "Config": {
    "Env": [
      "PATH=/app/.venv/bin:/usr/local/nvidia/bin:/usr/local/cuda/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
      "NVIDIA_REQUIRE_CUDA=cuda>=12.6 brand=tesla,driver>=470,driver<471",
      "NV_CUDA_LIB_VERSION=12.6.3-1",
      "NVIDIA_VISIBLE_DEVICES=all",
      "NVIDIA_DRIVER_CAPABILITIES=compute,utility",
      "LANG=C.UTF-8",
      "PYTHONUNBUFFERED=1"
    ],
    "Cmd": ["gunicorn", "--bind", "0.0.0.0:9000", "--workers", "1", "--timeout", "0", "app.webservice:app", "-k", "uvicorn.workers.UvicornWorker"],
    "Entrypoint": null,
    "User": "",
    "WorkingDir": "/app",
    "Labels": {
      "maintainer": "NVIDIA CORPORATION <cudatools@nvidia.com>",
      "org.opencontainers.image.ref.name": "ubuntu"
    }
  }
}
